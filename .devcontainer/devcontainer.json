{
  "name": "php2shell-lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [8081, 8082, 8083, 8084, 8085, 8086, 7777],
  "portsAttributes": {
    "8081": { "label": "8.4.25 tutorial" },
    "8082": { "label": "8.4.26 family" },
    "8083": { "label": "8.5.10 family" },
    "8084": { "label": "8.5.11 family" },
    "8085": { "label": "8.3.35 boss" },
    "8086": { "label": "8.1.34 research yard" },
    "7777": { "label": "scoreboard" }
  },
  "postCreateCommand": "./labctl doctor || true",
  "remoteUser": "vscode"
}
